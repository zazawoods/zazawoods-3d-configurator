{%- assign suffix = template.suffix | downcase -%}
{%- assign tname  = template.name   | downcase -%}
{%- assign show = false -%}
{%- if suffix == 'konfigurator' or tname == 'konfigurator' -%}
  {%- assign show = true -%}
{%- endif -%}

{%- if show -%}

{%- assign init_set       = 'angle' -%}
{%- assign init_length    = '' -%}
{%- assign init_backrests = '' -%}
{%- assign init_benches   = '' -%}

{%- for opt in product.options_with_values -%}
  {%- assign oname = opt.name | downcase | strip -%}
  {%- assign val   = opt.selected_value | default: '' | downcase | strip -%}
  {%- if val == '' -%}{%- continue -%}{%- endif -%}

  {%- if oname contains 'maß' or oname contains 'länge' or oname contains 'lange' or oname contains 'size' or oname contains 'length' -%}
    {%- assign digits = val | replace: 'cm', ' ' | replace: 'x', ' ' | replace: '×', ' ' -%}
    {%- assign parts = digits | split: ' ' -%}
    {%- for p in parts -%}
      {%- assign n = p | strip | times: 1 -%}
      {%- if n > 0 and init_length == '' -%}
        {%- assign init_length = n -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}

  {%- if oname contains 'tischbein' or oname contains 'gestell' or oname contains 'bein' -%}
    {%- if val contains 'x' -%}
      {%- assign init_set = 'picknick_Xshape' -%}
    {%- elsif val contains 'u' -%}
      {%- assign init_set = 'picknick_Ushape' -%}
    {%- endif -%}
  {%- endif -%}

  {%- if oname contains 'rückenlehne' or oname contains 'ruckenlehne' or oname contains 'backrest' -%}
    {%- if val contains 'keine' or val contains 'ohne' or val contains 'no' -%}
      {%- assign init_backrests = 0 -%}
    {%- elsif val contains '2' -%}
      {%- assign init_backrests = 2 -%}
    {%- elsif val contains '1' -%}
      {%- assign init_backrests = 1 -%}
    {%- endif -%}
  {%- endif -%}

  {%- if oname contains 'sitzbank' or oname contains 'sitzbänke' or oname contains 'bänke' or oname contains 'banke' or oname contains 'bench' -%}
    {%- if val contains 'keine' or val contains 'ohne' or val contains 'no' -%}
      {%- assign init_benches = 0 -%}
    {%- elsif val contains '2' -%}
      {%- assign init_benches = 2 -%}
    {%- elsif val contains '1' -%}
      {%- assign init_benches = 1 -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}

{%- assign target_url = '/pages/konfigurator?set=' | append: init_set -%}
{%- if init_length != '' -%}
  {%- assign target_url = target_url | append: '&length=' | append: init_length -%}
{%- endif -%}
{%- if init_backrests != '' -%}
  {%- assign target_url = target_url | append: '&backrests=' | append: init_backrests -%}
{%- endif -%}
{%- if init_benches != '' -%}
  {%- assign target_url = target_url | append: '&benches=' | append: init_benches -%}
{%- endif -%}

<a href="{{ target_url }}"
   class="zw-konfig-btn"
   id="zw-konfig-btn-{{ product.id }}"
   data-zw-konfig="1"
   aria-label="Konfigurator öffnen">
  <span class="zw-konfig-btn__ic" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
      <rect x="3" y="3" width="7" height="7" rx="1"/>
      <rect x="14" y="3" width="7" height="7" rx="1"/>
      <rect x="3" y="14" width="7" height="7" rx="1"/>
      <rect x="14" y="14" width="7" height="7" rx="1"/>
    </svg>
  </span>
  <span class="zw-konfig-btn__t">Konfigurator öffnen</span>
</a>

<style>
  .zw-konfig-btn {
    display: inline-flex; align-items: center; justify-content: center;
    gap: 10px; width: 100%;
    height: 47px; min-height: 47px;
    padding: 0 30px; margin: 16px 0;
    background: #577476; color: #fff;
    font-family: 'Switzer', -apple-system, "Segoe UI", Arial, sans-serif;
    font-size: 15px; font-weight: 400; line-height: 1; letter-spacing: 0;
    text-transform: none; text-decoration: none;
    border: 0; border-radius: 5px; box-shadow: none;
    cursor: pointer; transition: background .15s, transform .08s;
    box-sizing: border-box;
  }
  .zw-konfig-btn:hover  { background: #486264; }
  .zw-konfig-btn:active { transform: scale(.99); }
  .zw-konfig-btn:focus-visible { outline: 2px solid #577476; outline-offset: 2px; }
  .zw-konfig-btn__ic { display: inline-flex; width: 18px; height: 18px; flex: none; }
  .zw-konfig-btn__ic svg { width: 100%; height: 100%; }
  .zw-konfig-btn__t { white-space: nowrap; }
  @media (max-width: 749px) {
    .zw-konfig-btn { height: 44px; min-height: 44px; font-size: 14.5px; margin: 12px 0; }
  }
</style>

<script>
(function () {
  var btn = document.getElementById('zw-konfig-btn-{{ product.id }}');
  if (!btn) return;
  var PRODUCT = {{ product | json }};
  var OPTION_NAMES_LOWER = (PRODUCT.options || []).map(function (n) {
    return (typeof n === 'string' ? n : (n && n.name || '')).toLowerCase().trim();
  });
  var OPTION_NAMES_RAW = (PRODUCT.options || []).map(function (n) {
    return (typeof n === 'string' ? n : (n && n.name || ''));
  });

  function firstInt(s) {
    var m = (s || '').match(/\d+/);
    return m ? parseInt(m[0], 10) : null;
  }
  function mapOne(name, value) {
    if (!value) return null;
    var n = name.toLowerCase();
    var v = value.toLowerCase().trim();
    if (/maß|länge|lange|size|length/.test(n)) {
      var L = firstInt(v); return L ? { length: L } : null;
    }
    if (/tischbein|gestell|bein/.test(n)) {
      if (v.indexOf('x') !== -1) return { set: 'picknick_Xshape' };
      if (v.indexOf('u') !== -1) return { set: 'picknick_Ushape' };
      if (/(^|\W)w(\W|$)/.test(v)) return { set: 'angle' };
      return null;
    }
    if (/rückenlehne|ruckenlehne|backrest/.test(n)) {
      if (/keine|ohne|kein\b|no\b/.test(v)) return { backrests: 0 };
      if (v.indexOf('2') !== -1) return { backrests: 2 };
      if (v.indexOf('1') !== -1) return { backrests: 1 };
      return null;
    }
    if (/sitzbank|sitzbänke|bänke|banke|bench/.test(n)) {
      if (/keine|ohne|kein\b|no\b/.test(v)) return { benches: 0 };
      if (v.indexOf('2') !== -1) return { benches: 2 };
      if (v.indexOf('1') !== -1) return { benches: 1 };
      return null;
    }
    return null;
  }

  // Read the CURRENTLY-CHOSEN option values directly from the page.
  // Works for any Shopify theme: Dawn's <variant-selects> with <select>,
  // <variant-radios> with radios, or any custom theme using the standard
  // name="options[Foo]" convention.
  function readSelectedOptions() {
    var picked = {};   // option name → selected value
    // 1) Variant pickers (Dawn, Refresh, most modern themes)
    var pickers = document.querySelectorAll('variant-selects, variant-radios');
    pickers.forEach(function (p) {
      p.querySelectorAll('select').forEach(function (s) {
        var m = (s.name || '').match(/options\[(.+)\]/);
        if (m) picked[m[1]] = s.value;
      });
      p.querySelectorAll('input[type="radio"]:checked').forEach(function (r) {
        var m = (r.name || '').match(/options\[(.+)\]/);
        if (m) picked[m[1]] = r.value;
      });
    });
    // 2) Fallback: any standalone option inputs (older themes)
    document.querySelectorAll('input[name^="options["], select[name^="options["]').forEach(function (el) {
      var m = (el.name || '').match(/options\[(.+)\]/);
      if (!m) return;
      if (picked[m[1]]) return;
      if (el.tagName === 'SELECT') {
        picked[m[1]] = el.value;
      } else if (el.type === 'radio' && el.checked) {
        picked[m[1]] = el.value;
      } else if (el.type !== 'radio' && el.type !== 'checkbox') {
        picked[m[1]] = el.value;
      }
    });
    return picked;
  }

  function paramsFromSelectedOptions() {
    var picked = readSelectedOptions();
    var p = { set: 'angle' };  // Picknicktisch default (no leg option there)
    for (var i = 0; i < OPTION_NAMES_RAW.length; i++) {
      var rawName = OPTION_NAMES_RAW[i];
      var v = picked[rawName];
      if (!v) continue;
      var m = mapOne(rawName, v);
      if (m) Object.assign(p, m);
    }
    return p;
  }

  function buildUrl(p) {
    if (!p) return null;
    var qs = ['set=' + encodeURIComponent(p.set || 'angle')];
    if (p.length != null)    qs.push('length='    + p.length);
    if (p.backrests != null) qs.push('backrests=' + p.backrests);
    if (p.benches != null)   qs.push('benches='   + p.benches);
    return '/pages/konfigurator?' + qs.join('&');
  }

  function refresh() {
    try {
      var p = paramsFromSelectedOptions();
      var url = buildUrl(p);
      if (url) btn.setAttribute('href', url);
    } catch (e) { }
  }

  // Listen for any change on a variant-options control.
  // Conditions match Dawn (<select name="options[…]">), variant-radios
  // (radio inputs with the same naming), or hidden [name="id"] updates.
  document.addEventListener('change', function (ev) {
    var t = ev.target;
    if (!t) return;
    var name = t.name || '';
    var isOpt = name === 'id' || name.indexOf('options[') === 0;
    var inPicker = t.closest && t.closest('variant-selects, variant-radios');
    if (isOpt || inPicker) {
      // Slight defer so the theme can finish its own variant-change processing.
      setTimeout(refresh, 30);
    }
  }, true);

  // Custom events some themes dispatch.
  ['variant:change', 'variantChange', 'product:variantChange', 'on:variant:change'].forEach(function (ev) {
    document.addEventListener(ev, function () { setTimeout(refresh, 30); }, true);
  });

  // First-paint sync (in case theme picks a default variant after our snippet runs).
  setTimeout(refresh, 200);
  setTimeout(refresh, 1200);
})();
</script>

{%- endif -%}
