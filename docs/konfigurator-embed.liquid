{%- comment -%}
  Zaza Woods 3D Configurator — Shopify section (fullscreen iframe)
  ----------------------------------------------------------------
  Standardmäßig: füllt die Viewport-Breite und die VERFÜGBARE Höhe unter der
  Shopify-Navigation aus, sodass der "In den Warenkorb"-Button OHNE Scrollen
  sichtbar ist. Kein Titel, keine seitlichen Ränder.

  WICHTIG — Variant-Passthrough (Desktop UND Mobile):
  Der iframe wird OHNE src gerendert. Sobald die Section im DOM ist, liest
  ein Inline-Script die URL-Parameter (set, length, backrests, benches…)
  und setzt erst dann iframe.src auf die finale URL.

  Dieses "Defer-and-set" verhindert die Race-Condition auf Mobile (Safari
  iOS / Chrome Android), wo der iframe sonst manchmal mit dem Default-src
  startet, BEVOR das Script die Parameter anhängen kann — und die
  Vorbelegung damit verloren ging.

  Auf dem Desktop wirkt sich das nicht spürbar aus (das Script läuft
  ohnehin sofort beim Parsen).

  Kopiere den Inhalt in den Theme-Editor →
  Sections → konfigurator-embed.liquid → ALLES ersetzen → Save.
{%- endcomment -%}

<style>
  .zw-config-section {
    position: relative;
    width: 100vw;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    background: {{ section.settings.bg_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px 0;
    box-sizing: border-box;
    overflow-x: hidden;
  }
  .zw-config-wrap {
    width: 100%;
    {% if section.settings.max_width > 0 %}max-width: {{ section.settings.max_width }}px; margin: 0 auto;{% endif %}
    {% if section.settings.h_padding > 0 %}padding: 0 {{ section.settings.h_padding }}px; box-sizing: border-box;{% endif %}
  }
  .zw-config-frame {
    display: block;
    width: 100%;
    height: calc(100vh - {{ section.settings.nav_offset }}px);
    height: calc(100dvh - {{ section.settings.nav_offset }}px);
    min-height: 600px;
    border: 0;
    background: #F7F6F3;
    {% if section.settings.radius > 0 %}border-radius: {{ section.settings.radius }}px; overflow: hidden;{% endif %}
  }
  @media (max-width: 860px) {
    .zw-config-frame {
      height: calc(100vh - {{ section.settings.nav_offset_mobile }}px);
      height: calc(100dvh - {{ section.settings.nav_offset_mobile }}px);
      min-height: 520px;
    }
  }
  .zw-config-title { font-size: 28px; font-weight: 600; margin: 0 0 12px;
    color: #1A1A1A; text-align: {{ section.settings.title_align }}; }
  .zw-config-sub   { font-size: 15px; color: #6B6B6B; margin: 0 0 20px;
    text-align: {{ section.settings.title_align }}; }
</style>

{%- assign cfg_base = 'https://zazawoods-3d-configurator-production.up.railway.app/' -%}
{%- assign cfg_default_qs = '' -%}
{%- if section.settings.preselect_set != blank -%}
  {%- assign cfg_default_qs = '?set=' | append: section.settings.preselect_set -%}
  {%- if section.settings.preselect_length != blank -%}
    {%- assign cfg_default_qs = cfg_default_qs | append: '&length=' | append: section.settings.preselect_length -%}
  {%- endif -%}
{%- endif -%}

<div class="zw-config-section">
  <div class="zw-config-wrap">
    {%- if section.settings.title != blank -%}
      <h2 class="zw-config-title">{{ section.settings.title }}</h2>
    {%- endif -%}
    {%- if section.settings.subtitle != blank -%}
      <p class="zw-config-sub">{{ section.settings.subtitle }}</p>
    {%- endif -%}

    <iframe
      id="zw-config-iframe-{{ section.id }}"
      class="zw-config-frame"
      data-zw-base="{{ cfg_base }}"
      data-zw-default-qs="{{ cfg_default_qs }}"
      title="Zaza Woods 3D-Konfigurator"
      referrerpolicy="strict-origin-when-cross-origin"
      allow="camera; xr-spatial-tracking"></iframe>
  </div>
</div>

<script>
(function () {
  // Final-src builder: runs ONCE on parse, before the iframe has any src,
  // so there is no race between the default load and the param-aware load.
  // Same code on desktop and mobile — works identically on both.
  var WHITELIST = ['set', 'length', 'backrests', 'benches', 'finish', 'material'];
  var iframe = document.getElementById('zw-config-iframe-{{ section.id }}');
  if (!iframe) return;

  function setSrcOnce() {
    if (iframe.dataset.zwLoaded === '1') return;
    iframe.dataset.zwLoaded = '1';

    var base = iframe.getAttribute('data-zw-base') || '';
    var defaultQs = iframe.getAttribute('data-zw-default-qs') || '';
    var finalSrc = base + defaultQs;

    try {
      var url = new URL(location.href);
      var picked = [];
      WHITELIST.forEach(function (k) {
        var v = url.searchParams.get(k);
        if (v != null && v !== '') {
          picked.push(encodeURIComponent(k) + '=' + encodeURIComponent(v));
        }
      });
      if (picked.length) finalSrc = base + '?' + picked.join('&');
    } catch (e) {
      // keep defaultQs
    }
    iframe.src = finalSrc;
  }

  // Run as soon as possible — usually immediately, since this script sits
  // right after the iframe in the DOM.
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setSrcOnce, { once: true });
  } else {
    setSrcOnce();
  }
})();
</script>

{% schema %}
{
  "name": "3D Konfigurator",
  "tag": "section",
  "class": "zw-config-section-shopify",
  "settings": [
    { "type": "header", "content": "Überschrift (standardmäßig aus)" },
    { "type": "text",      "id": "title",        "label": "Titel" },
    { "type": "textarea",  "id": "subtitle",     "label": "Untertitel" },
    { "type": "select",    "id": "title_align",  "label": "Titel-Ausrichtung", "options": [
        { "value": "left",   "label": "Links" },
        { "value": "center", "label": "Zentriert" },
        { "value": "right",  "label": "Rechts" }
      ], "default": "center" },

    { "type": "header", "content": "Größe & Abstände" },
    { "type": "range", "id": "max_width",         "label": "Max. Breite (px, 0 = volle Breite)", "min": 0,   "max": 1800, "step": 20, "default": 0 },
    { "type": "range", "id": "nav_offset",        "label": "Höhe Shopify-Navi Desktop (px)",    "min": 0,   "max": 250,  "step": 5,  "default": 150,
                       "info": "Damit der iframe nicht hinter der Navigation versteckt ist. Erhöhe diesen Wert, wenn dein Header höher ist." },
    { "type": "range", "id": "nav_offset_mobile", "label": "Höhe Shopify-Navi Mobil (px)",      "min": 0,   "max": 200,  "step": 5,  "default": 90 },
    { "type": "range", "id": "padding_top",       "label": "Abstand oben (px)",                  "min": 0,   "max": 120,  "step": 4,  "default": 0 },
    { "type": "range", "id": "padding_bottom",    "label": "Abstand unten (px)",                 "min": 0,   "max": 120,  "step": 4,  "default": 0 },
    { "type": "range", "id": "h_padding",         "label": "Seitenabstand (px)",                 "min": 0,   "max": 60,   "step": 2,  "default": 0 },
    { "type": "range", "id": "radius",            "label": "Eckenradius (px)",                   "min": 0,   "max": 24,   "step": 2,  "default": 0 },
    { "type": "color", "id": "bg_color",          "label": "Hintergrund",                        "default": "#F7F6F3" },

    { "type": "header", "content": "Standard-Vorbelegung (optional)" },
    { "type": "text",  "id": "preselect_set",     "label": "Default Set (angle / picknick_Xshape / picknick_Ushape)" },
    { "type": "text",  "id": "preselect_length",  "label": "Default Länge (cm)" }
  ],
  "presets": [
    { "name": "3D Konfigurator" }
  ]
}
{% endschema %}
